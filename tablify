#!/usr/bin/env python3
"""Align markdown tables on the clipboard into monospace columns, wrapping long cells.

With no input, rewrites the clipboard in place. Given files or piped stdin, prints the
result (or rewrites the files with -i) and leaves the clipboard alone. Only GFM tables
are touched; all other lines, including anything inside ``` fences, pass through as-is.
"""
import argparse
import os
import re
import stat
import subprocess
import sys
import textwrap


def clip_read():
    return subprocess.run(["xclip", "-o", "-selection", "clipboard"],
                          capture_output=True, text=True, check=True, env=clip_env()).stdout


def clip_write(text):
    subprocess.run(["xclip", "-i", "-selection", "clipboard"],
                   input=text, text=True, check=True, env=clip_env(),
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)  # xclip lingers to serve the selection


def clip_env():
    env = dict(os.environ)
    env.setdefault("DISPLAY", ":1")
    return env


def split_row(line):
    """Split a `| a | b |` row on unescaped pipes, as GFM does (even inside backticks); `\\|` stays as-is."""
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|") and not s.endswith("\\|"):
        s = s[:-1]
    return [c.strip() for c in re.split(r"(?<!\\)\|", s)]


SEP_CELL = re.compile(r"^:?-+:?$")


def is_sep(cells):
    return all(SEP_CELL.match(c.replace(" ", "")) for c in cells if c) and any(cells)


def strip_markup(s):
    s = s.replace("**", "").replace("__", "")
    return s.replace("`", "")


def fit_widths(rows, natural, minimum, avail):
    """Start every column at its minimum, then spend the spare width where it saves the most wrapped lines."""
    widths = list(minimum)

    def height(ws):
        return sum(max(len(wrap(c, ws[i])) for i, c in enumerate(r)) for r in rows)

    spare = avail - sum(widths)
    cur = height(widths)
    while spare > 0:
        best = None
        for i in range(len(widths)):
            for k in range(1, min(spare, natural[i] - widths[i]) + 1):
                trial = widths[:i] + [widths[i] + k] + widths[i + 1:]
                h = height(trial)
                if h < cur:
                    gain = (cur - h) / k
                    if best is None or gain > best[0]:
                        best = (gain, i, k, h)
                    break
        if best is None:
            break
        _, i, k, cur = best
        widths[i] += k
        spare -= k
    # Leftover width goes to the columns that are still wrapped, spread evenly.
    while spare > 0:
        open_cols = [i for i in range(len(widths)) if widths[i] < natural[i]]
        if not open_cols:
            break
        for i in open_cols:
            if spare > 0:
                widths[i] += 1
                spare -= 1
    return widths


def wrap(cell, width):
    if len(cell) <= width:
        return [cell]
    return textwrap.wrap(cell, width, break_long_words=True, break_on_hyphens=False) or [""]


def render(rows, header_sep, args):
    ncols = max(len(r) for r in rows)
    rows = [r + [""] * (ncols - len(r)) for r in rows]
    if args.strip_markup:
        rows = [[strip_markup(c) for c in r] for r in rows]

    natural = [max(len(r[i]) for r in rows) or 1 for i in range(ncols)]
    longest_word = [max((len(w) for r in rows for w in r[i].split()), default=1) for i in range(ncols)]
    minimum = [min(natural[i], max(args.min_col, min(longest_word[i], args.max_word))) for i in range(ncols)]
    avail = args.width - (3 * ncols + 1)
    widths = natural if args.width <= 0 or sum(natural) <= avail else fit_widths(rows, natural, minimum, avail)

    wrapped = [[wrap(c, widths[i]) for i, c in enumerate(row)] for row in rows]
    # Trim each column to its widest line so a second pass finds nothing to change.
    widths = [max(len(l) for r in wrapped for l in r[i]) or 1 for i in range(ncols)]
    rule = "|" + "|".join("-" * (w + 2) for w in widths) + "|"
    out = []
    for n, cells in enumerate(wrapped):
        height = max(len(c) for c in cells)
        for k in range(height):
            parts = [(c[k] if k < len(c) else "").ljust(widths[i]) for i, c in enumerate(cells)]
            out.append("| " + " | ".join(parts) + " |")
        if n == 0 and header_sep:
            out.append(rule)
    return out


FENCE = re.compile(r"^\s*(`{3,}|~{3,})")


def is_row(line):
    return line.lstrip().startswith("|")


def merge(lines):
    """Join a header that we wrapped onto several lines back into a single row."""
    ncols = max(len(r) for r in lines)
    return [" ".join(r[c] for r in lines if c < len(r) and r[c]) for c in range(ncols)]


def tablify(text, args):
    """Reformat GFM tables (header row, then a |---| row); every other line passes through untouched."""
    nl = "\r\n" if "\r\n" in text else "\n"
    lines = text.splitlines()
    out, i, fence = [], 0, None
    while i < len(lines):
        line = lines[i]
        m = FENCE.match(line)
        if fence:
            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence):
                fence = None
        elif m:
            fence = m.group(1)
        if fence or m or not is_row(line):
            out.append(line)
            i += 1
            continue
        indent = line[:len(line) - len(line.lstrip())]
        j = i
        while j < len(lines) and is_row(lines[j]) and not FENCE.match(lines[j]):
            j += 1
        block = [split_row(l) for l in lines[i:j]]
        k = next((n for n, r in enumerate(block) if is_sep(r)), None)
        if not k:
            out.extend(lines[i:j])  # pipes, but not a table
        else:
            rows = [merge(block[:k])] + block[k + 1:]
            out.extend(indent + r for r in render(rows, True, args))
        i = j
    return nl.join(out) + (nl if text.endswith(("\n", "\r")) else "")


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("-w", "--width", type=int, default=120,
                   help="max table width; long cells wrap to fit (0 = never wrap, default 120)")
    p.add_argument("-k", "--strip-markup", action="store_true",
                   help="strip ** and ` markup from cells (kept by default)")
    p.add_argument("--min-col", type=int, default=8, help="narrowest a column may shrink to (default 8)")
    p.add_argument("--max-word", type=int, default=40,
                   help="words longer than this may be broken mid-word when wrapping (default 40)")
    p.add_argument("-f", "--fence", action="store_true", help="wrap the output in a ``` code block")
    p.add_argument("-p", "--print-only", action="store_true", help="clipboard mode: print, leave the clipboard alone")
    p.add_argument("-i", "--in-place", action="store_true", help="rewrite the given files instead of printing")
    p.add_argument("files", nargs="*", help="markdown files to format")
    args = p.parse_args()
    if args.in_place and not args.files:
        p.error("-i needs files")

    def run(text):
        result = tablify(text, args)
        return "```\n" + result.rstrip("\n") + "\n```\n" if args.fence else result

    if args.files:
        for path in args.files:
            with open(path, newline="") as f:
                text = f.read()
            result = run(text)
            if not args.in_place:
                sys.stdout.write(result)
            elif result != text:
                with open(path, "w", newline="") as f:
                    f.write(result)
        return

    mode = os.fstat(sys.stdin.fileno()).st_mode
    if stat.S_ISFIFO(mode) or stat.S_ISREG(mode):
        sys.stdout.write(run(sys.stdin.read()))
        return
    result = run(clip_read())
    sys.stdout.write(result)
    if not args.print_only:
        clip_write(result)

if __name__ == "__main__":
    main()
